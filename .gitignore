# Kurulum çıktısı
installer/dist/

# Training rig: keys, personal data and generated artifacts stay out of git.
# Committed exceptions: the synthetic teacher corpora and the base checkpoint
# (the seed of the nightly personal loop).
training/.env
training/data/*
!training/data/corpus.jsonl
!training/data/corpus_en.jsonl
training/checkpoints/*
!training/checkpoints/base.pt
training/site/

# Eski sürümün ayrı checkout'u (yasam_bench --eski): git worktree, depoya girmez.
eval/eski/

# Kapsam ölçümü çıktısı
.coverage
htmlcov/
