# Copy to `.env` (git-ignored) or export as an environment variable.
# Used by teacher.py for corpus generation/labeling — NOT needed to run neo,
# nor for the nightly personal loop (it uses the model configured in the app).
OPENROUTER_API_KEY=your-key-here

# Optional: raise/lower the hard budget stop (USD). Default 12.
# TEACHER_BUDGET_USD=12
